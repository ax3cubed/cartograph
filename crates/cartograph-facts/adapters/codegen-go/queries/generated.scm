; `// Code generated by github.com/oapi-codegen/oapi-codegen/v2 version v2.4.1 DO NOT EDIT.` and
; the Go convention `// Code generated ... DO NOT EDIT.` of any other generator. One generator is
; named per file: the first pattern that matches, so the general one comes last.
(
  (comment) @codegen.marker
  (#match? @codegen.marker "^// Code generated .*DO NOT EDIT")
  (#match? @codegen.marker "oapi-codegen")
  (#set! generator "oapi-codegen")
)

(
  (comment) @codegen.marker
  (#match? @codegen.marker "^// Code generated .*DO NOT EDIT")
  (#match? @codegen.marker "protoc-gen")
  (#set! generator "protoc-gen")
)

(
  (comment) @codegen.marker
  (#match? @codegen.marker "^// Code generated .*DO NOT EDIT")
  (#set! generator "go")
)
