; The banner of a generated file (XS-11). The generator is a constant of the pattern.
; orval 6 and 7: `Generated by orval v7.10.0` and `Do not edit manually.`
(
  (comment) @codegen.marker
  (#match? @codegen.marker "Generated by orval")
  (#set! generator "orval")
)

; openapi-typescript 6 and 7: `This file was auto-generated by openapi-typescript.`
(
  (comment) @codegen.marker
  (#match? @codegen.marker "auto-generated by openapi-typescript")
  (#set! generator "openapi-typescript")
)

; openapi-generator, typescript-fetch: `This class is auto generated by OpenAPI Generator`.
(
  (comment) @codegen.marker
  (#match? @codegen.marker "auto generated by OpenAPI Generator")
  (#set! generator "openapi-generator")
)

; protoc-gen-es and protoc-gen-ts: `@generated by protoc-gen-es v1.10.0 with parameter ...`.
(
  (comment) @codegen.marker
  (#match? @codegen.marker "@generated by protoc-gen")
  (#set! generator "protoc-gen")
)
