{
  "name": "cartograph",
  "version": "0.2.0",
  "description": "A codebase map: what each part does, how the parts link, and how those links changed over git history.",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ax3cubed/cartograph.git"
  },
  "homepage": "https://github.com/ax3cubed/cartograph#readme",
  "bugs": {
    "url": "https://github.com/ax3cubed/cartograph/issues"
  },
  "packageManager": "pnpm@11.23.0+sha512.f00082e5b283a199b74e079da28d155c008fe232f44c8a06ea7ddfa014ecf719fc362f790ecc67b28106ddac2afb24c49a9a079159da560b2ce7d1e98efd11af",
  "engines": {
    "node": ">=22",
    "pnpm": ">=11",
    "npm": "please-use-pnpm"
  },
  "scripts": {
    "preinstall": "node scripts/only-pnpm.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "check": "node --experimental-strip-types lib/workspace.check.ts",
    "gen:types": "json2ts --input crates/cartograph-api/schema.json --output lib/api/types.gen.ts --bannerComment \"// Generated from crates/cartograph-api (INT-01) by pnpm gen:types. Do not edit.\" --unreachableDefinitions --additionalProperties=false"
  },
  "dependencies": {
    "@assistant-ui/react": "0.15.37",
    "clsx": "^2.1.1",
    "d3-force": "^3.0.1",
    "lucide-react": "^1.70.0",
    "next": "16.4.5",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "^3.7.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "json-schema-to-typescript": "16.0.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  }
}
